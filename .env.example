# Content API (portfolio-backend) and this website's site slug in it.
CONTENT_API_URL=http://localhost:4000/api/v1
SITE_SLUG=shovon
# Shown once when the site is created in the admin dashboard (or by `npm run seed`);
# rotate it in Site settings if lost. The backend sends it to /api/revalidate after each save.
REVALIDATE_SECRET=
